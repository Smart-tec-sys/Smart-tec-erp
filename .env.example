# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=

# Alternativa: URL completa, sem credencial real neste arquivo.
DATABASE_URL=

# Autenticacao
SMARTTEC_AUTH_MODE=dev

# Supabase Auth
# Exemplo: https://SEU-PROJETO.supabase.co
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Issuer esperado dos JWTs de usuario.
# Normalmente: https://SEU-PROJETO.supabase.co/auth/v1
SUPABASE_AUTH_ISSUER=

# Public JWKS discovery endpoint.
# Normalmente:
# https://SEU-PROJETO.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Imagens (logo da empresa e foto do usuario), servidas pela API em /media/...
# local (padrao): pasta SMARTTEC_MEDIA_DIR (padrao: media). Nao persiste no Render.
# supabase: bucket PRIVADO acessado somente pela API; nunca expor a chave secreta no frontend.
SMARTTEC_MEDIA_STORAGE=local
SMARTTEC_MEDIA_DIR=
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=
